# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Environment & Secrets (CRITICAL: Never commit API keys)
.env
.env.*
!.env.example
*.local

# Virtual environments
venv/
.venv/
env/
ENV/

# Databases and Vector Stores (Local storage)
database/*.db
database/vector_store/*.json
!database/vector_store/.gitkeep
database/test_*.db

# Export Outputs (Generated user files)
outputs/pdf/*.pdf
outputs/word/*.docx
!outputs/pdf/.gitkeep
!outputs/word/.gitkeep

# Streamlit runtime
.streamlit/

# OS / Editor files
.DS_Store
Thumbs.db
*.log
